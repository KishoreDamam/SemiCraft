# SemiCraft frontend configuration.
#
# Copy to .env.local and edit. NEXT_PUBLIC_* variables are inlined when the dev
# server or the build starts, so restart after changing this.

# Base URL of the SemiCraft backend API. NO trailing slash.
#
#   UNSET  -> the app serves built-in DEMO DATA from mocks/: a small sample of
#             the catalog with fabricated output. Useful for UI work with no
#             backend running. The app shows a permanent banner in this mode,
#             so it can never be mistaken for the real thing -- but do not
#             deploy it this way.
#   SET    -> the app calls a real backend and generates real, lint-checked RTL.
#
# Local backend, started from the repository root with:
#   uv run uvicorn api.main:app --port 8000 --app-dir backend
NEXT_PUBLIC_API_BASE=http://localhost:8000

# The backend must allow this frontend's origin. It defaults to
# http://localhost:3000; anywhere else, set SEMICRAFT_CORS_ORIGINS in the
# BACKEND's environment (comma-separated, or "*" on a trusted network):
#   SEMICRAFT_CORS_ORIGINS=https://semicraft.example.com
